# BOOM account credentials. Accounts on the main API are created by an
# admin: there is no self-service signup. If you only have a Babamul
# account, use the babamul package instead.
BOOM_API_USER=your-username
BOOM_API_PASSWORD=your-password

# Which deployment to talk to: production (Caltech, default), backup
# (UMN) or local.
# BOOM_ENV=production

# Full override of the API base URL. Wins over BOOM_ENV.
# BOOM_API_URL=http://localhost:4000

# On-disk cache. Unset means no caching at all.
# BOOM_CACHE_DIR=~/.cache/boom
# BOOM_CACHE_MAX_AGE=86400
